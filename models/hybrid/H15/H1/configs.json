{
    "Mode": "New",
    "Module": "H15",
    "Model": "H15",
    "Optimizer": "Adam",
    "DatasetArgs": {
        "dataset_csv": "../../data/assembly/assembly.csv",
        "bootstrap": 0,
        "feature_list": ["A", "C", "G", "U", "MR"],
        "val_size": 0.15,
        "test_size": 0.15,
        "seed": 42,
        "batch_size": 4,
        "noise_scale": 4
    },
    "ModelArgs": {
        "d_model": 16,
        "num_layers": 3,
        "input_size": 5,
        "activation": "GELU",
        "channel_rate": 2,
        "pool_size": 4,
        "num_heads": 2,
        "dropout": 0.1
    },
    "OptimizerArgs": {
        "lr": 1e-4,
        "amsgrad": true
    },
    "AutopilotArgs": {
        "loss_fn": "L1Loss",
        "logits": false,
        "max_epochs": 64,
        "min_epochs": 4,
        "tolerance": 0,
        "output_dir": "H15/H1"
    }
}
